---
layout: null
sitemap: false
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- for p in site.pages -%}
    {%- if p.sitemap == false or p.url contains "404" -%}
      {%- continue -%}
    {%- endif -%}
    {%- if p.layout == "categoria" -%}
      {%- assign n = site.posts | where: "categoria", p.categoria | size -%}
      {%- if n == 0 -%}
        {%- continue -%}
      {%- endif -%}
    {%- endif -%}
  <url>
    <loc>{{ p.url | absolute_url }}</loc>
  </url>
  {%- endfor -%}
  {%- for post in site.posts -%}
    {%- unless post.example -%}
  <url>
    <loc>{{ post.url | absolute_url }}</loc>
  </url>
    {%- endunless -%}
  {%- endfor -%}
</urlset>
